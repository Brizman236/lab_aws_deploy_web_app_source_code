# Copier vers .env pour le développement local (le fichier .env est ignoré par git).
# Toutes les valeurs ci-dessous sont des exemples non secrets.

# Mode de configuration :
#   env (défaut) = les variables ci-dessous (développement local, .env)
#   aws          = Parameter Store + Secrets Manager (production). Dans ce mode, TOUTES les
#                  variables ci-dessous sont ignorées sauf les 4 variables « bootstrap » :
#                  CONFIG_SOURCE, SSM_PATH_PREFIX, DB_SECRET_ID, SECRET_KEY_SECRET_ID, AWS_REGION.
CONFIG_SOURCE=env
# --- Uniquement avec CONFIG_SOURCE=aws (à fournir par l'environnement du service, pas ici) ---
# SSM_PATH_PREFIX=/techsahel/production/
# DB_SECRET_ID=<nom ou ARN du secret RDS (JSON)>
# SECRET_KEY_SECRET_ID=<nom ou ARN du secret SECRET_KEY (texte brut)>
# AWS_REGION=eu-west-3
# (aucune clé AWS : le rôle IAM de l'instance fournit les credentials)

APP_ENV=development
APP_NAME=TechSahel Catalogue
LOG_LEVEL=INFO

# Connexion PostgreSQL (DSN libpq). En production : fournie par l'environnement, jamais commitée.
DATABASE_URL=postgresql://catalog_user:change-me@localhost:5432/product_catalog

# Clé de signature des jetons de formulaire. Obligatoire en production (valeur longue et aléatoire).
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Images : "local" = servies depuis static/images ; "remote" = servies depuis ASSET_BASE_URL (ex. S3/CloudFront).
STORAGE_BACKEND=local
ASSET_BASE_URL=/static/images
LOCAL_IMAGE_DIR=static/images

ITEMS_PER_PAGE=12

# Nombre de proxys de confiance devant l'application (ex. 1 derrière un load balancer). 0 = aucun.
TRUSTED_PROXY_HOPS=0

# Base dédiée aux tests automatisés (vidée à chaque exécution !).
TEST_DATABASE_URL=postgresql://catalog_user:change-me@localhost:5432/product_catalog_test
